{
  "name": "beactive",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=app/web",
    "build": "npm run build --workspace=app/web",
    "lint": "npm run lint --workspace=app/web",
    "type-check:web": "npm run type-check --workspace=app/web",
    "type-check:server": "node_modules/.bin/tsc --noEmit --project tsconfig.json",
    "type-check": "npm run type-check:web && npm run type-check:server",
    "prisma:generate": "npm run prisma:generate --workspace=app/web",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=app/web",
    "prisma:studio": "npm run prisma:studio --workspace=app/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:timezones": "node --env-file=app/web/.env.local scripts/audit-timezones.mjs",
    "backfill:completions": "node --env-file=app/web/.env.local scripts/backfill-completions.mjs",
    "validate:parity": "node --env-file=app/web/.env.local scripts/validate-streak-parity.mjs",
    "quality:gate": "node scripts/quality-gate.mjs",
    "review:route": "node scripts/review/route.mjs",
    "review:aggregate": "node scripts/review/aggregate.mjs",
    "loop:snapshot": "node scripts/loop-snapshot.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "prisma": "^5.22.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
