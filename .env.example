# ─── Database ─────────────────────────────────────────────────────────────────
# Runtime: use Supabase's PgBouncer pooler (port 6543) with connection_limit=1
# Migrations: use the direct connection (port 5432) via DIRECT_URL
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key"   # SERVER ONLY — never prefix with NEXT_PUBLIC_

# ─── Cloudflare R2 Storage ─────────────────────────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="beactive-uploads"
R2_PUBLIC_URL="https://your-bucket.your-domain.com"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# ─── AI Classification ─────────────────────────────────────────────────────────
# Provider selection — "gemini" (default, free tier) or "claude" (Anthropic)
AI_PROVIDER="gemini"                            # "gemini" (default) or "claude"

# Gemini API key — get free at https://aistudio.google.com/apikey
# Used for Gemini Flash workout image classification (gemini-2.0-flash)
GEMINI_API_KEY="your-gemini-api-key"           # SERVER ONLY — never prefix with NEXT_PUBLIC_

# Claude API key — get at https://console.anthropic.com/settings/keys
# Only needed if AI_PROVIDER=claude
# AI_API_KEY="sk-ant-your-key-here"            # SERVER ONLY — never prefix with NEXT_PUBLIC_

# ─── Apple Push Notifications (APNs) ───────────────────────────────────────────
# Provider-token auth (.p8 key) — create at https://developer.apple.com/account/resources/authkeys/list
# Optional: if unset, push sends silently no-op (notification rows still get created).
APNS_KEY_ID="your-apns-key-id"                   # SERVER ONLY — the .p8 key's Key ID
APNS_TEAM_ID="your-apple-team-id"                # SERVER ONLY — Apple Developer Team ID
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"  # SERVER ONLY — the .p8 file contents, newlines escaped as \n
APNS_BUNDLE_ID="com.arham.BeActive"              # iOS app's bundle identifier
APNS_ENVIRONMENT="development"                   # "development" (sandbox, matches Debug builds) or "production"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STREAK_DEBUG=""              # Set to "true" in .env.local to show StreakDebugPanel on /feed — NEVER in production

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# REQUIRED before production — the in-memory rate limiter is ineffective on
# Vercel serverless (memory resets per invocation). Provision via Vercel
# Marketplace → Upstash → Redis. Free tier covers ~10k req/day.
UPSTASH_REDIS_REST_URL="https://your-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# ─── Error Tracking ────────────────────────────────────────────────────────────
# REQUIRED before production. Setup: npx @sentry/wizard@latest -i nextjs
SENTRY_DSN="https://xxx@o0.ingest.sentry.io/0"

# ─── Cron Job Protection ────────────────────────────────────────────────────────
# Vercel sets this automatically in cron calls — generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# ─── QStash (Classification Queue) ─────────────────────────────────────────────
# Same Upstash account as the Redis vars below — enable at
# https://console.upstash.com/qstash
# QSTASH_TOKEN publishes jobs from posts/create; the signing keys verify
# inbound requests to /api/queue/classify (Receiver.verify tries current, then
# next — rotate by moving current->next, then issuing a new current).
# If these are unset (or publishing fails), posts/create falls back to running
# classification inline via after() — the post is never left stuck PENDING.
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-next-signing-key"

# ─── Upstash Redis (Rate Limiting) ─────────────────────────────────────────────
# Required for production rate limiting on Vercel serverless.
# Create a free Upstash Redis DB at https://console.upstash.com
# Without these, rate limiting silently falls back to non-functional in-memory store.
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
