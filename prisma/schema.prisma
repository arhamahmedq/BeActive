generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id
  email            String            @unique
  username         String            @unique
  displayName      String?
  avatarUrl        String?
  bio              String?           @db.VarChar(160)
  timezone         String            @default("UTC")
  tzChangedAt      DateTime?
  tzChangeCount    Int               @default(0)
  role             UserRole          @default(USER)
  onboarded        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dailyCompletions DailyCompletion[]
  events           Event[]
  friendshipsA     Friendship[]      @relation("FriendA")
  friendshipsB     Friendship[]      @relation("FriendB")
  receivedMessages Message[]         @relation("Receiver")
  sentMessages     Message[]         @relation("Sender")
  notifications    Notification[]
  posts            Post[]
  postLikes        PostLike[]
  postComments     PostComment[]
  streak           Streak?
  stories          Story[]
  deviceTokens     DeviceToken[]
}

model Post {
  id              String           @id @default(cuid())
  userId          String
  imageUrl        String
  imageKey        String
  caption         String?          @db.VarChar(500)
  status          PostStatus       @default(PENDING)
  classificationAttempts Int       @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dailyCompletion DailyCompletion?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout         Workout?
  likes           PostLike[]
  comments        PostComment[]
  story           Story?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

// Slice 8B — post engagement (interactions module). Isolated from posts core.
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) // one like per user per post (DB-enforced dedup)
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String   @db.VarChar(300)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Desc)])
}

model Workout {
  id           String      @id @default(cuid())
  postId       String      @unique
  type         WorkoutType
  aiConfidence Float
  modelVersion String
  processedAt  DateTime    @default(now())
  post         Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([aiConfidence])
}

model Streak {
  id               String       @id @default(cuid())
  userId           String       @unique
  current          Int          @default(0)
  best             Int          @default(0)
  status           StreakStatus @default(INACTIVE)
  brokenAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  lastVerifiedDate String?
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lastVerifiedDate])
}

model DailyCompletion {
  id        String   @id @default(cuid())
  userId    String
  localDate String
  postId    String   @unique
  timezone  String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId, localDate(sort: Desc)])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Friendship {
  id        String           @id @default(cuid())
  userAId   String
  userBId   String
  status    FriendshipStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userA     User             @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User             @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  title          String
  body           String?
  data           Json?
  read           Boolean          @default(false)
  idempotencyKey String?          @unique
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, type])
}

// One row per registered device per user — a user with the app on two
// phones gets two rows. Re-registering the same token (app reinstall, token
// refresh) upserts by token rather than growing duplicates.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   @default("ios")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Event {
  id            String   @id @default(cuid())
  type          String
  userId        String?
  payload       Json
  source        String
  correlationId String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([type, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([correlationId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String?  @db.VarChar(2000)
  imageUrl   String?
  imageKey   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  sender     User     @relation("Sender", fields: [senderId], references: [id])

  @@index([senderId, receiverId, createdAt(sort: Desc)])
  @@index([receiverId, read, createdAt(sort: Desc)])
}

// Story Sharing V3 — immutable payload snapshot + cached rendered asset.
// One row per Post (1:1). payload is frozen at WORKOUT_VERIFIED time so a
// re-render always reproduces the same card, regardless of later changes to
// the user's profile/streak.
model Story {
  id           String      @id @default(cuid())
  postId       String      @unique
  userId       String
  payload      Json
  shareVersion Int         @default(1)
  status       StoryStatus @default(PENDING_RENDER)
  assetKey     String?
  assetUrl     String?
  renderMs     Int?
  renderError  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

enum UserRole {
  USER
  ADMIN
}

enum PostStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WorkoutType {
  GYM
  RUNNING
  CYCLING
  SWIMMING
  OUTDOOR
  SPORTS
  OTHER
}

enum StreakStatus {
  INACTIVE
  ACTIVE
  BROKEN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum NotificationType {
  WELCOME
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  WORKOUT_VERIFIED
  WORKOUT_REJECTED
  FRIEND_POSTED
  STREAK_AT_RISK
  STREAK_BROKEN
}

enum StoryStatus {
  PENDING_RENDER
  READY
  FAILED
}
